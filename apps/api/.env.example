# Copy to .env and fill in. Never commit .env.
# Port 5000 is taken by AirPlay Receiver on macOS, so local dev uses 5050.
PORT=5050
# Use the payflow-dev database, never production.
MONGO_URI=
# Only for the API tests (npx nx test @payflow/api): the payflow-ci user,
# which can access only the payflow-test database. Never dev or production.
MONGO_URI_TEST=
# Any long random value, e.g. from: openssl rand -hex 32
JWT_SECRET=
# Websites allowed to call the API from a browser, comma-separated.
# Default when empty: http://localhost:5173
CORS_ORIGINS=http://localhost:5173
